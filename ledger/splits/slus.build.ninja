# GENERATED by tools/configure.py — do not edit by hand
builddir = build

rule cc
  command = tools/cc.sh $in $out $ccver "$ccflags" "$asflags"
  description = CC $in (gcc $ccver $ccflags $asflags)

rule as
  command = tools/as.sh $in $out
  description = AS $in

rule objbin
  command = mipsel-linux-gnu-ld --relocatable --format=binary -o $out $in
  description = BIN $in

rule orderld
  command = sed 's|build/src/konami_runtime.o(\.text)|build/src/konami_runtime*.o(SORT_BY_NAME(.text.func_*)) build/src/konami_runtime*.o(.text)|; s|build/src/code.o(\.text)|build/src/*.o(SORT_BY_NAME(EXCLUDE_FILE(build/src/konami_runtime*.o) .text.func_*)) build/src/*.o(EXCLUDE_FILE(build/src/konami_runtime*.o) .text)|' $in > $out
  description = LD-SCRIPT $out

rule link
  command = mipsel-linux-gnu-ld -EL -T build/slus_006.14_ordered.ld -T config/generated/slus_006.14.undefined_funcs.txt -T config/generated/slus_006.14.undefined_syms.txt --no-check-sections -o $out $in
  description = LINK $out

rule objcopy
  command = mipsel-linux-gnu-objcopy -O binary $in $out
  description = OBJCOPY $out

rule sha1
  command = sha1sum -c $in && touch $out
  description = SHA1 $in

