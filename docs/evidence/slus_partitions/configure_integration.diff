+                PARTITION_PATHS["parts"][parent["id"]][part["module"]])
+    partition_support.validate_context(PARTITIONS, MODULES, original_parent_edges,
+                                       "raw/slus", partition_aliases)
+    outputs = sorted([*PARTITION_PATHS["remainders"].values(),
