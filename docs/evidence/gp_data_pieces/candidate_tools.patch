+                        "module": None if receipt is None else receipt["module"],
+                        "post_object_sha256": object_hash},
+                       sort_keys=True) + "\n").encode("utf-8")
+    staged = _stage_bytes(path, data, 0o644)
+    try:
+        os.replace(staged, path)
+    finally:
+        staged.unlink(missing_ok=True)
+
+
