+                    raise ValueError(f"{source_name}: nonzero unselected alignment bytes")
+                ranges.append({"start": cursor, "end": item["start"]})
+            cursor = item["start"] + item["size"]
+        if cursor < old[5]:
+            if any(content[cursor:old[5]]):
