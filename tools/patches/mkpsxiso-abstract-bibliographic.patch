-
-	fprintf( fp, "/* %s */\n", name );
-
-	for ( const auto& e : entriesInDir )
-	{
-		const DIRENTRY& entry = e.get();
-		if ( !entry.id.empty() && entry.type != EntryType::EntryDir )
-		{
-			std::string temp_name = "LBA_" + entry.id;
