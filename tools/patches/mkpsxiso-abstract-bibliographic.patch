-		else if ( CompareICase( "dir", dirElement->Name() ))
-		{
-			if (!ParseDirEntry(dirTree, dirElement, xmlPath, defaultAttributes, currentPath))
-			{
-				return false;
-			}
-        }
-	}
-
-	return true;
-}
