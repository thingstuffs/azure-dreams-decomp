+/* r95_opus_T what-if switches: env R95_<NAME> = 1|3 both passes, s1 sched1 only, s2 sched2 only. */
+#include <stdlib.h>
+static int
+r95_sw (name)
+     char *name;
+{
+  char *v = getenv (name);
+  int mask;
+  if (!v || !*v || *v == '0')
+    return 0;
+  if (v[0] == 's' && v[1] == '1') mask = 1;
+  else if (v[0] == 's' && v[1] == '2') mask = 2;
+  else mask = 3;
+  return (mask & (reload_completed ? 2 : 1)) != 0;
+}
+#include <stdio.h>
+extern char *current_function_name;
+#define R95_MAXUID 400000
+static unsigned char r95_boost[R95_MAXUID];
