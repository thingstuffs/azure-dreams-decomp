 static int
+r95_class_of (x)
+     rtx x;
+{
+  rtx link;
+  if (!last_scheduled_insn)
+    return 0;
+  link = find_insn_list (x, LOG_LINKS (last_scheduled_insn));
+  if (link == 0 || insn_cost (x, link, last_scheduled_insn) == 1)
+    return 3;
+  else if (REG_NOTE_KIND (link) == 0)
+    return 1;
+  return 2;
+}
