+static int r95_nsets_max;
+static void
+r95_count_set (x)
+     rtx x;
+{
+  rtx d;
+  if (GET_CODE (x) != SET && GET_CODE (x) != CLOBBER)
+    return;
+  d = SET_DEST (x);
+  while (GET_CODE (d) == SUBREG || GET_CODE (d) == STRICT_LOW_PART
+	 || GET_CODE (d) == ZERO_EXTRACT || GET_CODE (d) == SIGN_EXTRACT)
+    d = XEXP (d, 0);
+  if (GET_CODE (d) == REG && REGNO (d) < r95_nsets_max)
+    r95_nsets[REGNO (d)]++;
+}
+static void
+r95_recount ()
+{
+  rtx insn;
+  int j;
+  r95_nsets_max = max_reg_num ();
+  r95_nsets = (int *) xmalloc (r95_nsets_max * sizeof (int));
+  bzero ((char *) r95_nsets, r95_nsets_max * sizeof (int));
+  for (insn = get_insns (); insn; insn = NEXT_INSN (insn))
+    if (GET_RTX_CLASS (GET_CODE (insn)) == 'i')
+      {
+	rtx pat = PATTERN (insn);
+	if (GET_CODE (pat) == PARALLEL)
+	  for (j = 0; j < XVECLEN (pat, 0); j++)
+	    r95_count_set (XVECEXP (pat, 0, j));
+	else
+	  r95_count_set (pat);
+      }
+}
+static int r95_class_of PROTO((rtx));
+/* R95_BOOSTCTL = "func:-uid,func:+uid,...": never / always boost that insn in sched1 */
+static int
+r95_boostctl (insn, b)
+     rtx insn;
+     int b;
+{
+  char *v = getenv ("R95_BOOSTCTL"), *q;
+  int n = strlen (current_function_name);
+  if (!v || !*v)
+    return b;
+  for (q = v; *q; )
+    {
+      char *c = strchr (q, ':');
+      if (!c)
+	break;
+      if (c - q == n && !strncmp (q, current_function_name, n))
+	{
+	  int sign = c[1] == '-' ? 0 : 1;
+	  int u = atoi (c + 2);
+	  if (u == INSN_UID (insn))
+	    b = sign;
+	}
+      q = strchr (c, ',');
+      if (!q)
+	break;
+      q++;
+    }
+  return b;
+}
