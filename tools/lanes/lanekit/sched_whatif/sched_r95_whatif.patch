+static void
+r95_decide (ready, n_ready, clock)
+     rtx *ready;
+     int n_ready, clock;
+{
+  static char *flips = 0;
+  static int flips_read = 0;
+  int idx, k, j, i;
+  char *lp, *q;
+  if (!flips_read)
+    {
+      flips = getenv ("R95_FLIP");
+      lp = getenv ("R95_LOG");
+      if (lp && *lp)
+	r95_log = fopen (lp, "a");
+      flips_read = 1;
+    }
+  if (n_ready < 2)
+    {
+      if (n_ready == 1 && insn_unit (ready[0]) == 0)
+	r95_memsched++;
+      return;
+    }
+  idx = r95_ndec++;
+  if (r95_log)
+    {
+      fprintf (r95_log, "D %d %s %s b%d T%d n%d haz%d m%d/%d |", idx, reload_completed ? "s2" : "s1",
+	       current_function_name, r95_block, clock, n_ready, r95_hazmoved, r95_memsched, unit_n_insns[0]);
+      for (i = 0; i < n_ready && i < 12; i++)
+	{
+	  rtx x = ready[i];
+	  int u = INSN_UID (x);
+	  int unit = insn_unit (x);
+	  fprintf (r95_log, " %d:p%d:o%d:b%d:l%d:c%d:u%d:h%d:%s", u, INSN_PRIORITY (x),
+		   u < R95_MAXUID ? r95_prio0[u] : -1, u < R95_MAXUID ? r95_boost[u] : 0,
+		   INSN_LUID (x), r95_class_of (x), unit,
+		   potential_hazard (unit, x, 0),
+		   GET_CODE (PATTERN (x)) == SET ? GET_RTX_NAME (GET_CODE (SET_SRC (PATTERN (x)))) : GET_RTX_NAME (GET_CODE (PATTERN (x))));
+	  if (GET_CODE (PATTERN (x)) == SET)
+	    fprintf (r95_log, "/%s", GET_RTX_NAME (GET_CODE (SET_DEST (PATTERN (x)))));
+	}
+      fprintf (r95_log, "\n");
+    }
+  r95_hazmoved = 0;
+  /* R95_FLIP = "idx:k,idx:k,..." : at decision idx schedule ready[k] instead of ready[0] */
+  if (flips)
+    for (q = flips; *q; )
+      {
+	int fi = strtol (q, &q, 10), fk = 1;
+	if (*q == ':')
+	  fk = strtol (q + 1, &q, 10);
+	if (fi == idx && fk > 0 && fk < n_ready)
+	  {
+	    rtx t = ready[fk];
+	    for (j = fk; j > 0; j--)
+	      ready[j] = ready[j - 1];
+	    ready[0] = t;
+	  }
+	while (*q == ',' || *q == ' ')
+	  q++;
+      }
+  if (insn_unit (ready[0]) == 0)
+    r95_memsched++;
+}
